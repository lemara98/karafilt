{
  "manifest_version": 3,
  "name": "Karaoke Filter",
  "version": "0.1.0",
  "description": "Real-time vocal removal for karaoke — removes vocals from any tab audio",
  "permissions": ["tabCapture", "offscreen", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' ws://localhost:9876"
  }
}
