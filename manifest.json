{
  "manifest_version": 3,
  "name": "Karaoke Filter",
  "version": "0.1.0",
  "description": "Real-time vocal removal for karaoke — removes vocals from any tab audio",
  "permissions": ["tabCapture", "offscreen", "activeTab", "tabs", "storage", "sidePanel"],
  "host_permissions": ["https://lrclib.net/*", "https://api.lyrics.ovh/*", "https://genius.com/*"],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/lyrics-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/yt-captions-injector.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' ws://localhost:* wss://* https://lrclib.net https://api.lyrics.ovh https://genius.com"
  }
}
